# Rock 5 board fragment, merged after arm64 defconfig + AOSP android-base.config.
#
# Milestone 1 builds the whole boot path into the kernel image (no modules in
# the ramdisk yet), so everything first-stage init and the display needs is =y.
# build-kernel.sh checks every option listed here actually ended up as set.

# Android needs SELinux in the active LSM list. arm64 defconfig fixes
# CONFIG_LSM before android-base.config turns SELinux on, and olddefconfig
# keeps that stale list, so selinuxfs fails to mount and first-stage init aborts.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,selinux,bpf"

# First-stage init needs /dev/device-mapper even without verity. defconfig has
# BLK_DEV_DM=m, which also caps android-base's DM_VERITY/DM_SNAPSHOT at m.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_SNAPSHOT=y

# netd uses legacy iptables. Since 6.17 the IP_NF_* tables sit behind these
# switches, which the android-6.12 fragment predates; the per-family ones
# default to m and would cap every table at m.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y

# Dependencies that hold android-base's IFB and HID_PLAYSTATION at m
CONFIG_NET_ACT_MIRRED=y
CONFIG_LEDS_CLASS_MULTICOLOR=y

# Android's task profiles use the cgroup v1 cpuset hierarchy (/dev/cpuset);
# since 6.12 that is a separate option the android-6.12 fragment predates.
CONFIG_CPUSETS_V1=y

# SoC basics
CONFIG_ARCH_ROCKCHIP=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_ARM_SCMI_CPUFREQ=y

# PMIC (RK806 on SPI) + CPU rails (RK8602, fan53555-compatible)
CONFIG_SPI_ROCKCHIP=y
CONFIG_MFD_RK8XX_SPI=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_I2C_RK3X=y

# Debug UART (ttyS2 @ 1500000)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# Storage: microSD (dw_mmc) + eMMC (sdhci-dwcmshc)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# Display: VOP2 + HDMI (dw-hdmi-qp) + HDPTX PHY
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI_QP=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX=y

# GPU: Mali-G610 (Panthor). Its CSF firmware is embedded via EXTRA_FIRMWARE
# by build-kernel.sh, because a built-in driver probes before /vendor is mounted.
CONFIG_DRM_PANTHOR=y

# PCIe + 2.5GbE (RTL8125B)
CONFIG_PCIE_ROCKCHIP_DW_HOST=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y
CONFIG_R8169=y

# USB host (keyboard/mouse, UVC cameras later)
CONFIG_USB_DWC3=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_TYPEC=y
CONFIG_PHY_ROCKCHIP_USBDP=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_HID=y
# USB touchscreens (e.g. ILITEK) are HID multitouch devices; defconfig has it
# =m, and hid-generic alone gives Android no usable touch input
CONFIG_HID_MULTITOUCH=y

# Android ramdisk is an lz4 cpio
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
